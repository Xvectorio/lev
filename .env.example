# Lev settings, next to compose.yaml (installed as .env; chmod 600, it holds keys). Empty or commented = default.
# Secrets are generated on first start; the admin account is created in the browser.

# Lev listens on all interfaces by default. Only reachable from this machine:
#BIND_ADDRESS=127.0.0.1

# Public server: your domain (automatic HTTPS) on the standard ports.
#SITE_ADDRESS=logs.example.com
#HTTP_PORT=80
#HTTPS_PORT=443
# Certificates via Cloudflare DNS instead (name not publicly reachable on port 80/443, e.g. LAN-only).
# Token needs Zone.DNS:Edit on that zone only.
#CLOUDFLARE_API_TOKEN=

# Pin an image release instead of the version compose.yaml was published with.
#LEV_VERSION=0.1.0

# Jev triage (TypeSafe) and optional prose explanations from an OpenAI-compatible model.
# These five can also be set in the UI (Settings), which overrides the values here.
TYPESAFE_API_KEY=
#TYPESAFE_MODEL=jev-latest
#AI_BASE_URL=https://api.openai.com/v1
#AI_API_KEY=
#AI_MODEL=
# Seed policy version 1 only; afterwards tune triage in the UI (Jev triage -> Policy / Tune wizard).
#TRIAGE_CONFIDENCE=0.8
#OBSERVE_CONFIDENCE=0.6
#LOOKBACK_SECONDS=600

# Retention: raw logs in Loki (hours, min 24, whole days recommended) and daily database dumps (days).
# Incidents, labels and audit in PostgreSQL are kept until you delete them.
#LOG_RETENTION_HOURS=48
#BACKUP_RETENTION_DAYS=14

# Identity of this host's own logs.
#LOCAL_SERVER_ID=local
#LOCAL_PROJECT_ID=host-infrastructure
#LOCAL_ENVIRONMENT=development
# Group owning /var/log/journal (stat -c %g /var/log/journal); only needed where container root can't read it.
#LOCAL_JOURNAL_GID=65534

# Development from a git checkout: build from source and enable the check services.
#COMPOSE_FILE=compose.yaml:compose.dev.yaml
