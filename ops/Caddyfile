(site) {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy same-origin
        Content-Security-Policy "default-src 'self'; style-src 'self'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
    }
    handle /loki/api/v1/push {
        basic_auth {
            vector {$VECTOR_HASH}
        }
        reverse_proxy loki:3100
    }
    # Operator auth is a session cookie checked by the API; agents use the bearer token.
    handle /api/* {
        reverse_proxy api:8000
    }
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
{$SITE_ADDRESS} {
    # Browsers ignore HSTS over plain HTTP, so this only takes effect once SITE_ADDRESS serves HTTPS.
    header Strict-Transport-Security "max-age=31536000"
    import site
}
# The bundled vector pushes to http://edge:80 whatever SITE_ADDRESS is. Only private addresses may use it,
# so an HTTPS install isn't also served over plain HTTP to the internet via Host: edge.
http://edge {
    @internal remote_ip private_ranges
    handle @internal {
        import site
    }
    handle {
        abort
    }
}
