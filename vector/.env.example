# Labels Lev shows and filters on. Keep them stable: a change starts new incident groups and sources.
# Host name as shown in Lev (host label).
VECTOR_HOST=server-01
# Unique ID for this server. Agents on this server pick up only incidents with this server_id.
VECTOR_SERVER_ID=server-01
# Project or customer this server belongs to; groups servers in the Fields tree.
VECTOR_PROJECT_ID=my-project
# JOURNAL_GID (Docker only): group ID of systemd-journal on this host, so Vector can read the journal: getent group systemd-journal
JOURNAL_GID=999
# Environment label, e.g. production, staging, test.
VECTOR_ENVIRONMENT=production
# Lev's base URL, without a path (Vector adds /loki/api/v1/push). Use https:// unless on a trusted network.
VECTOR_ENDPOINT=https://logs.example.com
# Ingest password: Lev → Sources → Copy ingest password
VECTOR_PASSWORD=paste-ingest-password-here
# Docker containers whose json-file logs to read: a container ID or glob (e.g. abc123* or *). The placeholder reads none.
VECTOR_CONTAINER_GLOB=replace-with-container-id
